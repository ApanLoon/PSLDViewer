Viewer_CLASSES	= $(Viewer_CLS:%=classes/psdlviewer/%)

Viewer_SOURCES	= $(Viewer_CLS:%.class=./psdlviewer/%.java)
Viewer_TARGET	= Viewer


TestWrite_CLASSES	= TestWrite.class            \
			  PSDLFile.class
TestWrite_SOURCES	= $(TestWrite_CLASSES:.class=.java)
TestWrite_TARGET	= TestWrite


CLASSES			= $(Viewer_CLASSES) #$(TestWrite_CLASSES)
SOURCES			= $(Viewer_SOURCES) #$(TestWrite_SOURCES)
TARGETS			= $(Viewer_TARGET) #$(TestWrite_TARGET)


# -------------------------------------------------------------

./classes/%.class:	./%.java
		javac $(JFLAGS)  $<


all:		$(TARGETS)

compile:	
		javac $(JFLAGS) $(SOURCES)

#manifest:	$(Viewer_CLASSES)
manifest:	compile
		echo "Manifest-Version: 1.0" > Manifest.mf;\
		echo "Main-Class: psdlviewer.PSDLViewer" >> Manifest.mf

jar:		manifest
		jar cmf Manifest.mf $(Viewer_TARGET).jar $(Viewer_ICONS) -C $(CLASSPATH) .

$(Viewer_TARGET):	jar
$(TestWrite_TARGET):	$(TestWrite_CLASSES)

,deploy:	;rm -fr deploy $(DEPLOYPATH)/$(DEPLOYNAME)_`date +%Y-%m-%d`.zip;\
		 zip -r $(DEPLOYPATH)/$(DEPLOYNAME)_`date +%Y-%m-%d`.zip \
	             $(Viewer_TARGET).jar options.xml;\

,cleanall:	;rm -rf Manifest.mf $(CLASSPATH)/* *~

